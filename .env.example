# salin jadi .env lalu isi nilai asli (file .env tidak ikut di-push)
TUNNEL_TOKEN=          # token tunnel Cloudflare (Zero Trust -> Networks -> Tunnels -> token)
DB_PASS=               # password root MariaDB di container
SESSION_SECRET=        # string acak panjang (contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
